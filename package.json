{
  "name": "haqa-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "HAQA Monorepo",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "HAQA-API",
      "HAQA-APP"
    ],
    "catalog": {
      "@eslint/eslintrc": "^3.2.0",
      "@eslint/js": "^9.18.0",
      "@nestjs/common": "^11.0.1",
      "@nestjs/core": "^11.0.1",
      "@types/node": "^22.10.7",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "eslint": "^9.18.0",
      "eslint-config-prettier": "^10.0.1",
      "eslint-plugin-prettier": "^5.2.2",
      "globals": "^16.0.0",
      "ioredis": "5.9.2",
      "prettier": "^3.4.2",
      "typescript": "^5.7.3",
      "typescript-eslint": "^8.20.0",
      "zod": "^4.1.12"
    }
  },
  "scripts": {
    "postinstall": "bun run scripts/verify-workspaces.ts",
    "install:skip-native": "bun install --ignore-scripts && bun run scripts/verify-workspaces.ts",
    "dev": "bun run dev:all",
    "dev:all": "bun run scripts/dev-all.ts",
    "dev:api": "bun scripts/run-workspace.ts haqa-api start:dev",
    "dev:app": "bun scripts/run-workspace.ts haqa-app dev",
    "build": "bun scripts/run-workspace.ts haqa-api build",
    "build:app": "bun scripts/run-workspace.ts haqa-app build",
    "build:all": "bun scripts/run-workspace.ts haqa-api build && bun scripts/run-workspace.ts haqa-app build",
    "start": "bun scripts/run-workspace.ts haqa-api start",
    "preview:app": "bun scripts/run-workspace.ts haqa-app preview",
    "lint": "bun scripts/run-workspace.ts haqa-api lint",
    "format": "bun scripts/run-workspace.ts haqa-api format",
    "test": "bun scripts/run-workspace.ts haqa-app test",
    "verify": "bun run scripts/verify-workspaces.ts"
  },
  "overrides": {
    "ioredis": "5.9.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1"
  }
}
